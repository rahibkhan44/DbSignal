<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Deterministic, debuggable builds. People step into libraries; make it work. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Package identity. Each src project APPENDS its own engine terms to PackageTags
       ($(PackageTags);sqlite;... etc). Without that, no package is findable by the
       technology it actually implements — tags and the package ID are the only things
       nuget.org search matches on. -->
  <PropertyGroup>
    <Authors>Rahib Khan</Authors>
    <Product>DbSignal</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rahibkhan44/DbSignal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rahibkhan44/DbSignal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>database;change-notification;cdc;change-tracking;cache-invalidation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- One icon, shared by every package. MSBuildThisFileDirectory so it resolves from
       the repo root regardless of which project is packing. Not Visible, so it does not
       clutter the solution tree. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
